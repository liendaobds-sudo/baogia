# ═══════════════════════════════════════════════
# ZeplaoPrint Backend — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Server ──
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://chat.yourdomain.com
API_BASE_URL=https://api.yourdomain.com

# ── Database ──
# Prod: DB_TYPE=postgres (required). Use NOSUPERUSER role zeplao_app when TENANT_RLS_ENABLED=true
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zeplao_app
DB_PASSWORD=                    # REQUIRED in production
DB_DATABASE=zeplao_erp

# ── Authentication ──
JWT_SECRET=                     # REQUIRED — openssl rand -hex 32
JWT_REFRESH_SECRET=             # REQUIRED — openssl rand -hex 32 (fail-fast if missing at token issue)
JWT_EXPIRES_IN=1h               # access token TTL (default 1h)
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_DEFAULT_PASSWORD=         # Optional — initial admin seed only

# ── Redis (blacklist, BullMQ, Socket.IO scale-out) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# Production: Redis down → JWT blacklist fail-closed (tokens treated as revoked)

# ── Tenant isolation ──
# Keep false until DB role + Phase B RLS applied (see backend/db/TENANT-RLS-RUNBOOK.md)
TENANT_RLS_ENABLED=false

# ── Public quote API (chat widget) ──
# Production REQUIRES this key (header X-Api-Key). Without it, endpoint returns 503.
PUBLIC_QUOTE_API_KEY=

# ── Test chat (dev/QA) ──
# In production, /test-chat is 404 unless ENABLE_TEST_CHAT=true (admin roles only)
# ENABLE_TEST_CHAT=true

# ── Rate limit ──
THROTTLE_TTL=60000
THROTTLE_LIMIT=1200

# ── AI Providers (at least one) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Automation ──
SLA_MINUTES=10
