# ═══════════════════════════════════════════════
# ZeplaoPrint Backend — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Server ──
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://chat.yourdomain.com
API_BASE_URL=https://api.yourdomain.com

# ── Database ──
# Dev: DB_TYPE=sqlite (no setup needed)
# Prod: DB_TYPE=postgres (recommended)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zeplao
DB_PASSWORD=                    # REQUIRED — use a strong password
DB_DATABASE=zeplao

# ── Authentication ──
JWT_SECRET=                     # REQUIRED — generate: openssl rand -hex 32
ADMIN_PASSWORD=                 # Optional — initial admin password

# ── AI Providers (at least one required) ──
GEMINI_API_KEY=                 # Google Gemini
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=               # OpenAI (optional)
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=                 # Groq (optional)
# GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_2_KEY=              # Fallback AI key (defaults to GEMINI_API_KEY)

# ── ERP Integration ──
ERP_API_URL=http://localhost/Pricing/PricingPrint-backend/api/public/v1
ERP_API_KEY=                    # ERP API authentication key
ERP_EMBED_URL=http://localhost/Pricing/PricingPrint/embed.php

# ── Automation ──
SLA_MINUTES=10
